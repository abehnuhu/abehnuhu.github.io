rules_version = '2';

// ============================================================
// HOUSE OF BAIDEN — Firestore security rules
//
// How to deploy: Firebase Console → Firestore Database → Rules
// (or `firebase deploy --only firestore`)
//
// IMPORTANT (security): after creating your admin account
// (admin@houseofbaiden.com), paste your admin UID below and
// uncomment the strict line so ONLY you can write. Find your UID
// in Firebase Console → Authentication → Users.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn();
      // STRICT MODE — uncomment and paste your admin UID:
      // return request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }

    // PRODUCTS — anyone can browse the storefront; only the
    // signed-in admin can add, edit, or delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ORDERS — customers can place orders without an account;
    // only the admin can view or update them.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
